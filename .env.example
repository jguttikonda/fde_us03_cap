GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GEMINI_API_KEY=YOUR-VOCAREUM-KEY-HERE
GOOGLE_GEMINI_BASE_URL=https://gemini.vocareum.com
ADK_MODEL=gemini-3.5-flash
# Controller Operations execution bounds (defaults shown)
# AOG_OPERATIONS_TIMEOUT_SECONDS=30
# AOG_OPERATIONS_MAX_WORKERS=2
# Operations Agent policy (mock capstone values; all optional, defaults shown)
# AOG_OPS_DELAY_MEDIUM_MINUTES=60
# AOG_OPS_DELAY_HIGH_MINUTES=180
# AOG_OPS_DELAY_CRITICAL_MINUTES=360
# AOG_OPS_TURNAROUND_BUFFER_MINUTES=30
# AOG_OPS_TIME_CONFLICT_THRESHOLD_MINUTES=60
# AOG_OPS_EVIDENCE_MAX_AGE_MINUTES=60
# AOG_OPS_MAX_RETRIES=1
# AOG_OPS_DELAY_COST_PER_MINUTE_USD=85
# AOG_OPS_SWAP_COST_USD=18000
